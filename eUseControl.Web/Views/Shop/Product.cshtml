@using eUSeControl.BusinessLogic.Dtos.ProductDtos;
@model List<ProductDto>
@{
    ViewBag.Title = "Products";
}

<script>
    const allProducts = @Html.Raw(Json.Encode(Model.Select(p => new {
        id = p.Id,
        name = p.Name,
        price = p.Price,
        category = p.Category.ToString().ToLower(),
        imageUrl = Url.Content(p.ImageUrl),
        isFavorite = p.IsFavorite ?? false
    })));
</script>

<!-- Product -->
<div class="bg0 p-t-30 p-b-140 mt-2">
    <div class="container h-full">
        <div class="flex-w flex-sb-m align-items-center p-b-30">
            <h2 class="ltext-103 cl5 m-b-0">
                All Products
            </h2>
            <div class="flex-w flex-c-m">
                <div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 js-show-search">
                    <i class="icon-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-search"></i>
                    <i class="icon-close-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
                    Search
                </div>
            </div>
        </div>

        <!-- Search product -->
        <div class="dis-none panel-search w-full p-t-10 p-b-15">
            <div class="bor8 dis-flex p-l-15">
                <button class="size-113 flex-c-m fs-16 cl2 hov-cl1 trans-04">
                    <i class="zmdi zmdi-search"></i>
                </button>
                <input class="mtext-107 cl2 size-114 plh2 p-r-15" type="text" name="search-product" placeholder="Search">
            </div>
        </div>

        <div class="row isotope-grid" id="product-list"></div>
    </div>
</div>

@section Scripts{
    <script>
        const container = document.getElementById("product-list");
        const searchInput = document.querySelector("input[name='search-product']");

        function renderProducts(products) {
            container.innerHTML = '';
            if (products.length === 0) {
                container.innerHTML = '<p class="cl3">No products found.</p>';
                return;
            }

            products.forEach(p => {
                const div = document.createElement('div');
                div.className = `col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item ${p.category}`;
                div.innerHTML = `
                                    <div class="block2">
                                        <div class="block2-pic hov-img0">
                                            <img src="${p.imageUrl}" alt="${p.name}" />
                                            <a href="/Shop/ProductDetails/${p.id}" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                                                Quick View
                                            </a>
                                        </div>
                                        <div class="block2-txt flex-w flex-t p-t-14">
                                            <div class="block2-txt-child1 flex-col-l">
                                                <a href="/Shop/ProductDetails/${p.id}" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                                                    ${p.name}
                                                </a>
                                                <span class="stext-105 cl3">
                                                    ${p.price.toFixed(2)} MDL
                                                </span>
                                            </div>
                                            <div class="block2-txt-child2 flex-r p-t-3">
                                                <a onclick="toggleFavorite(${p.id})"
                                                   class="btn-addwish-b2 dis-block pos-relative js-addwish-b2 m-r-20 ${p.isFavorite ? 'favorited' : ''}"
                                                   data-product-id="${p.id}"
                                                   id="wish-${p.id}">
                                                    <img id="heart-${p.id}"
                                                         class="icon-heart dis-block trans-04 ab-t-l"
                                                         src="/Content/images/icons/icon-heart-01.png"
                                                         alt="heart" />
                                                </a>
                                            </div>
                                        </div>
                                    </div>`;
                container.appendChild(div);
            });
        }

        function filterProducts() {
            const keyword = searchInput?.value?.toLowerCase() ?? "";
            const filtered = allProducts.filter(p =>
                p.name.toLowerCase().includes(keyword)
            );
            renderProducts(filtered);
        }

        document.addEventListener("DOMContentLoaded", () => {
            renderProducts(allProducts);
            searchInput?.addEventListener("input", filterProducts);
        });
    </script>
}