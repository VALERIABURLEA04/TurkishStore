            </div>
        </div>

        <div class="row isotope-grid" id="product-list">
        </div>

        <!-- Load more -->
        @*<div class="flex-c-m flex-w w-full p-t-45">
                <a href="#" class="flex-c-m stext-101 cl5 size-103 bg2 bor1 hov-btn1 p-lr-15 trans-04">
                    Load More
                </a>
            </div>*@
    </div>
</section>

@section Scripts{
    <script>
        const container = document.getElementById("product-list");
        const searchInput = document.querySelector("input[name='search-product']");
        let currentCategory = "*";
        let currentPrice = "all";
        let currentColor = "all";

        function renderProducts(products) {
            container.innerHTML = '';
            if (products.length === 0) {
                container.innerHTML = '<p class="cl3">No products found.</p>';
                return;
            }

            products.forEach(p => {
                const div = document.createElement('div');
                div.className = `col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item ${p.category}`;
                div.innerHTML = `
                        <div class="block2">
                            <div class="block2-pic hov-img0">
                                <img src="${p.imageUrl}" alt="${p.name}" />
                                <a href="/Shop/ProductDetails/${p.id}" class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                                    Quick View
                                </a>
                            </div>
                            <div class="block2-txt flex-w flex-t p-t-14">
                                <div class="block2-txt-child1 flex-col-l">
                                    <a href="/Shop/ProductDetails/${p.id}" class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
                                        ${p.name}
                                    </a>
                                    <span class="stext-105 cl3">
                                        ${p.price.toFixed(2)} MDL
                                    </span>
                                </div>
                                <div class="block2-txt-child2 flex-r p-t-3">
                                    <a onclick="toggleFavorite(${p.id})"
                                        class="btn-addwish-b2 dis-block pos-relative js-addwish-b2 m-r-20 ${p.isFavorite ? 'favorited' : ''}"
                                        data-product-id="${p.id}"
                                        id="wish-${p.id}">
                                        <img id="heart-${p.id}" class="icon-heart dis-block trans-04 ab-t-l"
                                                src="/Content/images/icons/icon-heart-01.png" alt="heart" />
                                    </a>
                                </div>
                            </div>
                        </div>`;
                container.appendChild(div);
            });
        }

        function filterProducts() {
            const keyword = searchInput?.value?.toLowerCase() ?? "";
            const filtered = allProducts.filter(p =>
                (currentCategory === "*" || p.category === currentCategory) &&
                (currentPrice === "all" || p.priceRange === currentPrice) &&
                (currentColor === "all" || p.color === currentColor) &&
                p.name.toLowerCase().includes(keyword)
            );
            renderProducts(filtered);
        }

        document.addEventListener("DOMContentLoaded", () => {
            renderProducts(allProducts);

            searchInput?.addEventListener("input", filterProducts);

            document.querySelectorAll("[data-filter]").forEach(btn => {
                btn.addEventListener("click", () => {
                    document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("how-active1"));
                    btn.classList.add("how-active1");
                    currentCategory = btn.getAttribute("data-filter").replace(".", "");
                    filterProducts();
                });
            });

            document.querySelectorAll(".filter-col2 .filter-link").forEach(link => {
                link.addEventListener("click", e => {
                    e.preventDefault();
                    document.querySelectorAll(".filter-col2 .filter-link").forEach(l => l.classList.remove("filter-link-active"));
                    link.classList.add("filter-link-active");
                    currentPrice = link.textContent.includes("All") ? "all" : link.textContent.replace(/[\$MDL\s]/g, '').replace('.00', '').replace('+', '+').replace('–', '-').trim();
                    currentPrice = currentPrice.replace('--', '-');
                    filterProducts();
                });
            });

            document.querySelectorAll(".filter-col3 .filter-link").forEach(link => {
                link.addEventListener("click", e => {
                    e.preventDefault();
                    document.querySelectorAll(".filter-col3 .filter-link").forEach(l => l.classList.remove("filter-link-active"));
                    link.classList.add("filter-link-active");
                    currentColor = link.textContent.toLowerCase().trim();
                    filterProducts();
                });
            });
        });
    </script>
}