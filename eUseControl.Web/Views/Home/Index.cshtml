@using eUSeControl.BusinessLogic.Dtos.ProductDtos;
@model List<ProductDto>
@{
    ViewBag.Title = "Home";
}

<script>
    const allProducts = @Html.Raw(Json.Encode(Model.Select(p => new {
        id = p.Id,
        name = p.Name,
        price = p.Price,
        category = p.Category.ToString().ToLower(),
        imageUrl = Url.Content(p.ImageUrl),
        isFavorite = p.IsFavorite ?? false
    })));
</script>

