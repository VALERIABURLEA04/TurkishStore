@using System.Web.Optimization
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="icon" type="image/png" href="~/Content/images/icons/favicon.png" />
    <link rel="stylesheet" type="text/css" href="~/Content/css/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="~/Content/fonts/font-awesome-4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="~/Content/fonts/iconic/css/material-design-iconic-font.min.css">
    <link rel="stylesheet" type="text/css" href="~/Content/fonts/linearicons-v1.0.0/icon-font.min.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/animate/animate.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/css-hamburgers/hamburgers.min.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/animsition/css/animsition.min.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/select2/select2.min.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/daterangepicker/daterangepicker.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/slick/slick.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/MagnificPopup/magnific-popup.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/perfect-scrollbar/perfect-scrollbar.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/util.css">
    <link rel="stylesheet" type="text/css" href="~/Content/css/main.css">

    @Styles.Render("~/bundles/css")
</head>
<body class="animsition">
    @Html.Partial("_Header")
    @Html.Partial("_Cart")

    <div class="main p-t-100">
        @RenderBody()
    </div>

    @Html.Partial("_Footer")

    <!-- Back to top -->
    <div class="btn-back-to-top" id="myBtn">
        <span class="symbol-btn-back-to-top">
            <i class="zmdi zmdi-chevron-up"></i>
        </span>
    </div>

    <!-- Modal -->
    <div class="wrap-modal1 js-modal1 p-t-60 p-b-20">
        <div class="overlay-modal1 js-hide-modal1"></div>

        <div class="container">
            <div class="bg0 p-t-60 p-b-30 p-lr-15-lg how-pos3-parent">
                <button class="how-pos3 hov3 trans-04 js-hide-modal1">
                    <img src="~/Content/images/icons/icon-close.png" alt="CLOSE">
                </button>

                <div class="row">
                    <div class="col-md-6 col-lg-7 p-b-30">
                        <div class="p-l-25 p-r-30 p-lr-0-lg">
                            <div class="wrap-slick3 flex-sb flex-w">
                                <div class="wrap-slick3-dots"></div>
                                <div class="wrap-slick3-arrows flex-sb-m flex-w"></div>

                                <div class="slick3 gallery-lb">
                                    <div class="item-slick3" data-thumb="@Url.Content("~/Content/images/product-detail-01.jpg")">
                                        <div class="wrap-pic-w pos-relative">
                                            <img src="~/Content/images/product-detail-01.jpg" alt="IMG-PRODUCT">

                                            <a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="~/Content/images/product-detail-01.jpg">
                                                <i class="fa fa-expand"></i>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="item-slick3" data-thumb="@Url.Content("~/Content/images/product-detail-02.jpg")">
                                        <div class="wrap-pic-w pos-relative">
                                            <img src="~/Content/images/product-detail-02.jpg" alt="IMG-PRODUCT">

                                            <a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="~/Content/images/product-detail-02.jpg">
                                                <i class="fa fa-expand"></i>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="item-slick3" data-thumb="@Url.Content("~/Content/images/product-detail-03.jpg")">
                                        <div class="wrap-pic-w pos-relative">
                                            <img src="~/Content/images/product-detail-03.jpg" alt="IMG-PRODUCT">

                                            <a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="~/Content/images/product-detail-03.jpg">
                                                <i class="fa fa-expand"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/jquery/jquery-3.2.1.min.js"></script>
    <script src="~/Scripts/animsition/js/animsition.min.js"></script>
    <script src="~/Scripts/bootstrap/js/popper.js"></script>
    <script src="~/Scripts/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/Scripts/select2/select2.min.js"></script>
    <script>
        $(".js-select2").each(function () {
            $(this).select2({
                minimumResultsForSearch: 20,
                dropdownParent: $(this).next('.dropDownSelect2')
            });
        })
    </script>
    <script src="~/Scripts/daterangepicker/moment.min.js"></script>
    <script src="~/Scripts/daterangepicker/daterangepicker.js"></script>
    <script src="~/Scripts/slick/slick.min.js"></script>
    <script src="~/Scripts/js/slick-custom.js"></script>
    <script src="~/Scripts/parallax100/parallax100.js"></script>
    <script>
        $('.parallax100').parallax100();
    </script>
    <script src="~/Scripts/MagnificPopup/jquery.magnific-popup.min.js"></script>
    <script>
        $('.gallery-lb').each(function () {
            $(this).magnificPopup({
                delegate: 'a',
                type: 'image',
                gallery: {
                    enabled: true
                },
                mainClass: 'mfp-fade'
            });
        });
    </script>
    <script src="~/Scripts/isotope/isotope.pkgd.min.js"></script>
    <script src="~/Scripts/sweetalert/sweetalert.min.js"></script>
    <script>
        $('.js-addwish-b2').on('click', function (e) {
            e.preventDefault();
        });

        $('.js-addwish-b2').on('click', function (e) {
            e.preventDefault();

            var $btn = $(this);
            var nameProduct = $btn.closest('.block2').find('.js-name-b2').text().trim();

            var isNowAdded = !$btn.hasClass('js-addedwish-b2');
            $btn.toggleClass('js-addedwish-b2', isNowAdded);

            var actionText = isNowAdded ? 'added to' : 'removed from';
            swal(nameProduct, 'is ' + actionText + ' wishlist!', 'success');
        });

        $('.js-addwish-detail').on('click', function (e) {
            e.preventDefault();
            const $btn = $(this);
            const nameProduct = $btn.closest('.js-name-detail').text().trim() ||
                $btn.closest('.block2').find('.js-name-b2').text().trim();

            const isNowAdded = !$btn.hasClass('js-addedwish-detail');
            $btn.toggleClass('js-addedwish-detail', isNowAdded);

            const actionText = isNowAdded ? 'added to' : 'removed from';
            swal(nameProduct, `is ${actionText} wishlist!`, 'success');
        });

        $('.js-addcart-detail').on('click', function (e) {
            e.preventDefault();
            const $btn = $(this);
            const nameProduct = $btn.closest('.js-name-detail').text().trim() ||
                $btn.closest('.block2').find('.js-name-b2').text().trim();
            swal(nameProduct, 'is added to cart!', 'success');
        });
    </script>
    <script src="~/Scripts/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script>
        $('.js-pscroll').each(function () {
            $(this).css('position', 'relative');
            $(this).css('overflow', 'hidden');
            var ps = new PerfectScrollbar(this, {
                wheelSpeed: 1,
                scrollingThreshold: 1000,
                wheelPropagation: false,
            });

            $(window).on('resize', function () {
                ps.update();
            })
        });
    </script>
    <script src="~/Scripts/js/main.js"></script>

    <script>
        const isAuthenticated = @Html.Raw(Session["LoginStatus"]?.ToString() == "login" ? "true" : "false");

        function updateHeaderCount(delta) {
            const el = document.getElementById('favorite-count');
            if (!el) return;
            let cnt = parseInt(el.getAttribute('data-notify')) || 0;
            cnt = Math.max(0, cnt + delta);
            el.setAttribute('data-notify', cnt);
        }

        function getFavoritesCookie() {
            const name = "favorites=";
            const parts = decodeURIComponent(document.cookie).split(';');
            for (let c of parts) {
                c = c.trim();
                if (c.indexOf(name) === 0) {
                    try { return JSON.parse(c.substring(name.length)); }
                    catch { return []; }
                }
            }
            return [];
        }

        function setFavoritesCookie(list) {
            const d = new Date();
            d.setTime(d.getTime() + 30 * 24 * 60 * 60 * 1000);
            document.cookie = `favorites=${JSON.stringify(list)};expires=${d.toUTCString()};path=/`;
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (!isAuthenticated) {
                const favs = getFavoritesCookie();
                favs.forEach(id => {
                    const anchor = document.getElementById(`wish-${id}`);
                    if (anchor) anchor.classList.add('addedwish');
                });
            }
        });

        const emptySrc = '/Content/images/icons/icon-heart-01.png';
        const fullSrc = '/Content/images/icons/icon-heart-02.png';

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll('.js-addwish-b2').forEach(el => {
                const id = +el.getAttribute('data-product-id');
                const img = document.getElementById(`heart-${id}`);
                if (isAuthenticated) {
                    if (el.classList.contains('favorited')) {
                        img.src = fullSrc;
                    }
                } else {
                    if (getFavoritesCookie().includes(id)) {
                        img.src = fullSrc;
                    }
                }
            });
        });

        function toggleFavorite(productId) {
            const img = document.getElementById(`heart-${productId}`);
            if (isAuthenticated) {
                fetch(`/Shop/ToggleFavorite/${productId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: productId })
                })
                    .then(r => r.json())
                    .then(data => {
                        img.src = data.isFavorite ? fullSrc : emptySrc;
                        updateHeaderCount(data.isFavorite ? +1 : -1);
                        document.getElementById(`wish-${productId}`)
                            .classList.toggle('favorited', data.isFavorite);
                    });
            } else {
                let favs = getFavoritesCookie();
                const idx = favs.indexOf(productId);
                const add = idx === -1;
                if (add) favs.push(productId);
                else favs.splice(idx, 1);
                setFavoritesCookie(favs);
                img.src = add ? fullSrc : emptySrc;
                updateHeaderCount(add ? +1 : -1);
            }
        }

        const cartList = document.querySelector('.header-cart-wrapitem');
        const totalDiv = document.querySelector('.header-cart-total');

        function renderCartItems(items) {
            cartList.innerHTML = '';
            let total = 0;

            console.log(items)

            items.forEach(item => {
                const li = document.createElement('li');
                li.className = "header-cart-item flex-w flex-t m-b-12";

                li.innerHTML = `
                     <div class="header-cart-item-img">
                         <img src="${item.ImageUrl}" alt="IMG">
                     </div>
                     <div class="header-cart-item-txt p-t-8">
                         <a href="/Shop/ProductDetails/${item.ProductId}" class="header-cart-item-name m-b-18 hov-cl1 trans-04">
                             ${item.Name}
                         </a>
                         <span class="header-cart-item-info">
                             ${item.Quantity} x ${item.Price} MDL
                         </span>
                     </div>
                 `;

                total += item.Quantity * item.Price;
                cartList.appendChild(li);
            });

            totalDiv.textContent = `Total: ${total.toFixed(2)} MDL`;
        }

        function getCartItemsFromLocalStorage() {
            try {
                return JSON.parse(localStorage.getItem('cart')) || [];
            } catch {
                return [];
            }
        }

        function loadCart() {
            if (isAuthenticated) {
                fetch('/Cart/GetCartItems')
                    .then(res => res.json())
                    .then(data => renderCartItems(data))
                    .catch(err => console.error("Error loading cart from server:", err));
            } else {
                const localItems = getCartItemsFromLocalStorage();
                renderCartItems(localItems);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.js-show-cart').forEach(btn => {
                btn.addEventListener('click', loadCart);
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('#adminDropdownMobileToggle').forEach(function (el) {
                el.addEventListener('click', function (e) {
                    e.preventDefault();
                    this.closest('.dropdown').classList.toggle('show');
                });
            });
            document.addEventListener('click', function (e) {
                document.querySelectorAll('.dropdown.show').forEach(function (dd) {
                    if (!dd.contains(e.target)) dd.classList.remove('show');
                });
            });
        });
    </script>

    @Scripts.Render("~/bundles/js")
    @RenderSection("Scripts", required: false)
</body>
</html>